# Optional. Without a key the app runs fully in rules mode (demo-safe).
# Put ONE of these in .env.local (never commit it). Gemini is used if both are present.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Gemini default: gemini-3.5-flash (falls back to 3.5-flash-lite, 3.8-flash
# when busy). Anthropic default: claude-opus-5-5.
# NAGRIK_MODEL=
# Set to "off" to force rules mode even when a key is present
# NAGRIK_LLM=off

# Officer dashboard access code (6 digits). If unset, the app runs in demo mode and
# shows a demo code on the officer login page — always set this outside a demo.
# NAGRIK_OFFICER_CODE=
